# G3 Energy — environment variables
# Copy to `.env.local` for local dev, or set in Vercel → Project → Settings → Environment Variables.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Verified sender in Resend (required for production on your domain)
# After verifying g3energy.com in Resend, use:
RESEND_FROM_EMAIL=G3 Energy International <noreply@g3energy.com>

# For quick local testing only (delivers to your Resend account email):
# RESEND_FROM_EMAIL=G3 Energy <onboarding@resend.dev>

# Primary inbox for general enquiries
CONTACT_TO_EMAIL=info@g3energy.com

# Inbox for "Investment Partnership" enquiries (optional — defaults to partnerships@g3energy.com)
CONTACT_PARTNERSHIP_EMAIL=partnerships@g3energy.com

# Optional comma-separated CC list (e.g. a shared inbox)
# CONTACT_CC_EMAIL=

# Send a confirmation email to the person who submitted the form (default: true)
CONTACT_AUTO_REPLY=true

# Rate limit: max contact requests per IP per minute
CONTACT_RATE_LIMIT=5

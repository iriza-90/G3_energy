# G3 Energy — environment variables
# Copy to `.env.local` for local, or set in Vercel → Project → Settings → Environment Variables.

# Where contact form messages should be delivered
CONTACT_TO_EMAIL=info@g3energy.com

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Must be a verified sender in Resend.
# For quick testing you can use: onboarding@resend.dev
# (Resend then only delivers to the email on your Resend account.)
RESEND_FROM_EMAIL=G3 Energy <onboarding@resend.dev>

# Rate limit: max contact requests per IP per minute
CONTACT_RATE_LIMIT=5
